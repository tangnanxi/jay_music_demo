# 复制本文件为 .env，填入你的真实 key（.env 不要提交到仓库）
QQ_APP_ID=你的appid
QQ_APP_KEY=你的appkey

# 可选：监听地址。本机调试用默认；部署到服务器对公网暴露时设为 0.0.0.0
# HOST=0.0.0.0

# 可选：端口（默认 8000）
# PORT=8000

# 可选：用户登录态，配了才能拿到播放 url（VIP）；只做元数据可不填
# QQ_OPEN_ID=
# QQ_ACCESS_TOKEN=

# 可选：切测试环境网关
# QQ_GATEWAY=https://test.y.qq.com/opentest/rpc_proxy/fcgi-bin/music_open_api.fcg
